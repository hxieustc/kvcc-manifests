<?xml version="1.0" encoding="UTF-8"?>
<!--
  develop.xml — active development manifest
  Tracks the working branches for the Dynamo router and vLLM KVCC integration.

  Usage:
    repo init -u https://github.com/hxieustc/kvcc-manifests.git -m manifests/develop.xml
    repo sync
-->
<manifest>
  <remote name="github" fetch="https://github.com" />
  <default remote="github" sync-j="4" />

  <!-- Manifest repo — synced so scripts/ and locked/ are available in workspace -->
  <project name="hxieustc/kvcc-manifests"
           path="manifests"
           revision="develop" />

  <!-- Dynamo runtime and KV router (router_hints branch) -->
  <project name="ai-dynamo/dynamo"
           path="dynamo"
           revision="oandreeva/router_hints" />

  <!-- vLLM with KVCC secondary-tier support -->
  <project name="mkhazraee/vllm-priv"
           path="vllm"
           revision="main_kvcc" />

</manifest>
